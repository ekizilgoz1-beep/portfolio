---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Petals from '../components/Petals.astro';
import Arrow from '../components/Arrow.astro';
import { profile } from '../data/profile';
import { url } from '../lib/url';

/* Portrait facultatif : fichier déposé dans src/assets/ et référencé dans profile.ts */
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const portrait = profile.portrait ? images[`/src/assets/${profile.portrait}`]?.default : undefined;
---

<section class="hero" aria-labelledby="hero-title">
  <Petals />
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow" data-reveal>
        BTS SIO · option SISR <span class="hero__sep" aria-hidden="true">—</span>
        <span class="hero__place">{profile.school}, {profile.city}</span>
      </p>
      <h1 id="hero-title" class="hero__title" data-reveal data-reveal-delay="80">
        {profile.name}
      </h1>
      <p class="hero__tagline" data-reveal data-reveal-delay="160">
        Systèmes, réseaux <em>&amp;</em> cybersécurité
      </p>
      <p class="hero__intro" data-reveal data-reveal-delay="240">{profile.hero.intro}</p>
      <p class="hero__goal" data-reveal data-reveal-delay="300">{profile.hero.goal}</p>

      <div class="hero__actions" data-reveal data-reveal-delay="380">
        <a class="action action--primary" href="#projets">Voir mes projets <Arrow /></a>
        <a class="action action--ghost" href="#contact">Me contacter</a>
        {
          profile.cvUrl && (
            <a class="action action--text" href={url(profile.cvUrl)} download>
              Télécharger mon CV <Arrow direction="down" />
            </a>
          )
        }
      </div>
    </div>

    <div class="hero__visual" data-reveal data-reveal-delay="200">
      <div class="portrait">
        {
          portrait ? (
            <Image
              src={portrait}
              alt={profile.portraitAlt}
              width={560}
              height={680}
              loading="eager"
              fetchpriority="high"
              class="portrait__img"
            />
          ) : (
            <div class="portrait__empty" aria-hidden="true">
              <span class="portrait__initials">{profile.initials}</span>
            </div>
          )
        }
        <span class="portrait__outline" aria-hidden="true"></span>
      </div>
    </div>
  </div>

  <a class="hero__cue" href="#a-propos" data-reveal data-reveal-delay="600">
    <Arrow direction="down" />
    <span>Découvrir</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 6vw, 6rem) clamp(4rem, 8vw, 7rem);
    min-height: calc(100svh - 4.25rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-5);
  }

  .hero__sep {
    margin-inline: 0.5em;
    color: var(--line-strong);
  }

  .hero__place {
    text-transform: none;
    letter-spacing: 0.02em;
    font-weight: 500;
  }

  .hero__title {
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .hero__tagline {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    font-weight: 400;
    font-variation-settings: 'opsz' 40;
    color: var(--clay);
    line-height: var(--leading-snug);
  }

  .hero__tagline em {
    font-style: normal;
    color: var(--taupe);
  }

  .hero__intro {
    margin-top: var(--space-6);
    max-width: 34rem;
    font-size: var(--text-md);
    line-height: 1.65;
  }

  .hero__goal {
    margin-top: var(--space-4);
    max-width: 34rem;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-7);
  }

  /* Portrait — cadre en forme de pétale */
  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .portrait {
    position: relative;
    width: min(100% - 1.5rem, 17rem);
    aspect-ratio: 4 / 5;
  }

  .portrait__img,
  .portrait__empty {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 7rem 1.25rem 7rem 1.25rem;
    background: var(--sand);
  }

  .portrait__empty {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 30% 20%, var(--rose) 0%, transparent 55%),
      var(--sand);
  }

  .portrait__initials {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(4rem, 12vw, 6.5rem);
    font-variation-settings: 'opsz' 144;
    color: var(--clay-soft);
    letter-spacing: -0.04em;
    transform: translateY(-2%);
  }

  /* Contour décalé : donne de l'épaisseur sans ombre portée */
  .portrait__outline {
    position: absolute;
    inset: 0;
    border: 1px solid var(--line-strong);
    border-radius: 7rem 1.25rem 7rem 1.25rem;
    transform: translate(0.9rem, 0.9rem) rotate(-1.5deg);
    z-index: 0;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .portrait:hover .portrait__outline {
    transform: translate(1.2rem, 1.1rem) rotate(-2.5deg);
  }

  /* Invitation à défiler */
  .hero__cue {
    position: absolute;
    left: var(--gutter);
    bottom: var(--space-5);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .hero__cue :global(svg) {
    width: 0.9em;
    height: 0.9em;
    animation: cue-bob 2.8s var(--ease-in-out) infinite;
  }

  .hero__cue:hover {
    color: var(--clay);
  }

  @keyframes cue-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }

  @media (max-width: 47.99em) {
    .hero__cue {
      display: none;
    }
  }

  @media (min-width: 48em) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-7);
    }

    .hero__visual {
      justify-content: flex-end;
      padding-right: 1rem;
    }

    .portrait {
      width: min(100%, 22rem);
    }
  }

  @media (min-width: 64em) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }

    .portrait {
      width: min(100%, 24rem);
    }
  }
</style>
