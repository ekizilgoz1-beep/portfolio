---
import SectionHeading from '../components/SectionHeading.astro';
import Placeholder from '../components/Placeholder.astro';
import { profile } from '../data/profile';
---

<section id="a-propos" class="section section--tinted" aria-labelledby="about-title">
  <div class="container">
    <SectionHeading number="01" title="À propos" id="about-title" />

    <div class="about">
      <div class="about__text" data-reveal>
        {profile.about.paragraphs.map((p) => <p>{p}</p>)}
        {
          profile.about.personal ? (
            <p>{profile.about.personal}</p>
          ) : (
            <p>
              <Placeholder text="Paragraphe personnel à rédiger : parcours, ce qui m'a menée vers l'informatique, ce qui m'anime." />
            </p>
          )
        }
      </div>

      <aside class="about__facts" aria-label="En bref" data-reveal data-reveal-delay="120">
        <p class="eyebrow">En bref</p>
        <dl class="facts">
          {
            profile.about.facts.map((f) => (
              <div class="facts__row">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  .about__text {
    max-width: var(--measure);
  }

  .about__text p + p {
    margin-top: 1.1em;
  }

  .about__facts {
    padding: var(--space-5) var(--space-6);
    background: var(--paper);
    border-radius: var(--petal-radius);
    border: 1px solid var(--line);
  }

  .facts {
    margin-top: var(--space-4);
  }

  .facts__row {
    display: grid;
    gap: 0.15rem;
    padding-block: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .facts__row:last-child {
    padding-bottom: 0;
  }

  .facts dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-variation-settings: 'opsz' 20;
    color: var(--ink);
  }

  @media (min-width: 48em) {
    .about {
      grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 1fr);
      gap: var(--space-8);
    }
  }
</style>
