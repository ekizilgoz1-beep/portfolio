---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page introuvable" description="Cette page n’existe pas ou a été déplacée.">
  <section class="section notfound">
    <div class="container">
      <p class="eyebrow">Erreur 404</p>
      <h1 class="notfound__title">Cette page s’est envolée.</h1>
      <p class="lede notfound__text">L’adresse demandée n’existe pas ou a été déplacée.</p>
      <p class="notfound__actions">
        <a class="action action--primary" href={url('/')}>Retour à l’accueil <Arrow /></a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    min-height: 60vh;
  }

  .notfound__title {
    margin-top: var(--space-2);
  }

  .notfound__text {
    margin-top: var(--space-4);
  }

  .notfound__actions {
    margin-top: var(--space-6);
  }
</style>
