---
/** Petite flèche fine utilisée dans les liens d'action. */
interface Props {
  direction?: 'right' | 'left' | 'down';
}
const { direction = 'right' } = Astro.props;
const paths = {
  right: 'M2.5 8h11M9 3.5 13.5 8 9 12.5',
  left: 'M13.5 8h-11M7 3.5 2.5 8 7 12.5',
  down: 'M8 2.5v11M3.5 9 8 13.5 12.5 9',
};
---

<svg
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[direction]} />
</svg>
