---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projets'>;
  index: number;
}
const { project, index } = Astro.props;
const { title, summary, period, technologies, placeholder } = project.data;
const href = url(`/projets/${project.id}/`);
const number = String(index + 1).padStart(2, '0');
---

<li class="entry" data-reveal data-reveal-delay={String(index * 60)}>
  <span class="entry__number" aria-hidden="true">{number}</span>
  <div class="entry__body">
    <h4 class="entry__title">
      <a href={href}>
        {title}
        <Arrow />
      </a>
    </h4>
    <p class="entry__meta">
      {period && <span>{period}</span>}
      {placeholder && <span class="placeholder">contenu à compléter</span>}
    </p>
    <p class="entry__summary">{summary}</p>
    {
      technologies.length > 0 && (
        <ul class="tag-list entry__tags" aria-label="Technologies">
          {technologies.map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</li>

<style>
  .entry {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .entry:last-child {
    border-bottom: 1px solid var(--line);
  }

  .entry__number {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--ink-muted);
    padding-top: 0.15em;
  }

  .entry__title {
    font-size: var(--text-lg);
    font-variation-settings: 'opsz' 32;
  }

  .entry__title a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  .entry__title a:hover {
    color: var(--clay);
  }

  .entry__title :global(svg) {
    width: 0.6em;
    height: 0.6em;
    align-self: center;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .entry__title a:hover :global(svg),
  .entry__title a:focus-visible :global(svg) {
    opacity: 1;
    transform: none;
  }

  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin-top: 0.2rem;
  }

  .entry__meta:empty {
    display: none;
  }

  .entry__summary {
    margin-top: var(--space-3);
    max-width: var(--measure);
  }

  .entry__tags {
    margin-top: var(--space-4);
  }

  @media (min-width: 48em) {
    .entry {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
