# Copier ce fichier en `.env` pour un build local avec les bonnes URLs.
# En production, ces variables sont fournies par la plateforme (voir DEPLOIEMENT.md).

# URL publique du site (sans slash final)
SITE_URL=https://votre-domaine.fr

# Chemin de base. Laisser vide (ou "/") sur un domaine dédié.
# Sur GitHub Pages sans domaine personnalisé : /nom-du-depot
BASE_PATH=/
